<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.asynctask.mapper.TaskEventLogMapper">
    <!-- 启用二级缓存，使用LRU策略，20秒过期，最多缓存1000个对象 -->
    <cache eviction="LRU" flushInterval="20000" size="1000" readOnly="true"/>

    <resultMap id="BaseResultMap" type="com.example.asynctask.entity.TaskEventLog">
        <id column="id" property="id"/>
        <result column="task_id" property="taskId"/>
        <result column="event_type" property="eventType" typeHandler="com.example.asynctask.handler.EventTypeTypeHandler"/>
        <result column="event_data" property="eventData"/>
        <result column="operator" property="operator"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, task_id, event_type, event_data, operator, create_time
    </sql>

    <!-- 插入事件日志 -->
    <insert id="insert" parameterType="com.example.asynctask.entity.TaskEventLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO task_event_log (
            task_id, event_type, event_data, operator, create_time
        ) VALUES (
            #{taskId}, #{eventType, typeHandler=com.example.asynctask.handler.EventTypeTypeHandler},
            #{eventData}, #{operator}, #{createTime}
        )
    </insert>

    <!-- 根据ID查询事件日志 -->
    <select id="findById" resultMap="BaseResultMap" parameterType="java.lang.Long">
        SELECT <include refid="Base_Column_List"/>
        FROM task_event_log
        WHERE id = #{id}
    </select>

    <!-- 根据任务ID查找事件日志，按创建时间倒序 -->
    <select id="findByTaskIdOrderByCreateTimeDesc" resultMap="BaseResultMap" parameterType="java.lang.String">
        SELECT <include refid="Base_Column_List"/>
        FROM task_event_log
        WHERE task_id = #{taskId}
        ORDER BY create_time DESC
    </select>

    <!-- 根据任务ID和事件类型查找事件日志 -->
    <select id="findByTaskIdAndEventTypeOrderByCreateTimeDesc" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM task_event_log
        WHERE task_id = #{taskId}
        AND event_type = #{eventType, typeHandler=com.example.asynctask.handler.EventTypeTypeHandler}
        ORDER BY create_time DESC
    </select>

    <!-- 分页查询事件日志 -->
    <select id="findByPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM task_event_log
        <where>
            <if test="eventType != null">
                AND event_type = #{eventType, typeHandler=com.example.asynctask.handler.EventTypeTypeHandler}
            </if>
            <if test="startTime != null">
                AND create_time >= #{startTime}
            </if>
            <if test="endTime != null">
                AND create_time &lt;= #{endTime}
            </if>
            <if test="operator != null and operator != ''">
                AND operator = #{operator}
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 统计事件日志总数 -->
    <select id="countByConditions" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM task_event_log
        <where>
            <if test="eventType != null">
                AND event_type = #{eventType, typeHandler=com.example.asynctask.handler.EventTypeTypeHandler}
            </if>
            <if test="startTime != null">
                AND create_time >= #{startTime}
            </if>
            <if test="endTime != null">
                AND create_time &lt;= #{endTime}
            </if>
            <if test="operator != null and operator != ''">
                AND operator = #{operator}
            </if>
        </where>
    </select>

    <!-- 统计各事件类型数量 -->
    <select id="countByEventType" resultType="java.lang.Object">
        SELECT event_type, COUNT(*)
        FROM task_event_log
        GROUP BY event_type
    </select>

    <!-- 统计指定任务的事件类型数量 -->
    <select id="countByEventTypeAndTaskId" resultType="java.lang.Object" parameterType="java.lang.String">
        SELECT event_type, COUNT(*)
        FROM task_event_log
        WHERE task_id = #{taskId}
        GROUP BY event_type
    </select>

    <!-- 删除指定时间之前的事件日志 -->
    <delete id="deleteByCreateTimeBefore" parameterType="java.time.LocalDateTime">
        DELETE FROM task_event_log
        WHERE create_time &lt; #{beforeTime}
    </delete>

    <!-- 删除指定任务的所有事件日志 -->
    <delete id="deleteByTaskId" parameterType="java.lang.String">
        DELETE FROM task_event_log
        WHERE task_id = #{taskId}
    </delete>

    <!-- 查找最近的任务事件 -->
    <select id="findRecentEvents" resultMap="BaseResultMap" parameterType="java.lang.Integer">
        SELECT <include refid="Base_Column_List"/>
        FROM task_event_log
        ORDER BY create_time DESC
        LIMIT #{limit}
    </select>

    <!-- 查找任务的关键事件（创建、开始、完成、失败） -->
    <select id="findKeyEventsByTaskId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM task_event_log
        WHERE task_id = #{taskId}
        AND event_type IN
        <foreach collection="eventTypes" item="eventType" open="(" separator="," close=")">
            #{eventType, typeHandler=com.example.asynctask.handler.EventTypeTypeHandler}
        </foreach>
        ORDER BY create_time ASC
    </select>

    <!-- 根据ID删除事件日志 -->
    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM task_event_log
        WHERE id = #{id}
    </delete>

</mapper>