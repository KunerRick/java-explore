<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <!-- 全局配置 -->
    <settings>
        <!-- 开启驼峰命名自动映射 -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- 开启二级缓存 -->
        <setting name="cacheEnabled" value="true"/>
        <!-- 开启懒加载 -->
        <setting name="lazyLoadingEnabled" value="true"/>
        <!-- 设置超时时间（秒） -->
        <setting name="defaultStatementTimeout" value="30"/>
        <!-- 设置获取数据的策略，FIFO先入先出 -->
        <setting name="defaultFetchSize" value="100"/>
        <!-- 允许使用方法签名中的名称作为语句参数名称 -->
        <setting name="useActualParamName" value="true"/>
        <!-- 设置默认执行器类型 -->
        <setting name="defaultExecutorType" value="REUSE"/>
        <!-- 开启自动映射 -->
        <setting name="autoMappingBehavior" value="PARTIAL"/>
        <!-- 开启自动映射未知列 -->
        <setting name="autoMappingUnknownColumnBehavior" value="WARNING"/>
        <!-- 本地缓存机制 -->
        <setting name="localCacheScope" value="SESSION"/>
        <!-- 当结果集中含有null值时，是否调用映射对象的setter -->
        <setting name="callSettersOnNulls" value="true"/>
        <!-- 指定哪个对象的方法触发一次延迟加载 -->
        <setting name="lazyLoadTriggerMethods" value="equals,clone,hashCode,toString"/>
    </settings>

    <!-- 类型别名 -->
    <typeAliases>
        <package name="com.example.asynctask.entity"/>
    </typeAliases>

    <!-- 类型处理器 -->
    <typeHandlers>
        <!-- 处理JSON类型 -->
        <typeHandler handler="com.example.asynctask.handler.JsonTypeHandler"/>
        <!-- 处理枚举类型 -->
        <typeHandler handler="com.example.asynctask.handler.TaskStatusTypeHandler" javaType="com.example.asynctask.entity.AsyncTask$TaskStatus"/>
        <typeHandler handler="com.example.asynctask.handler.StepStatusTypeHandler" javaType="com.example.asynctask.entity.TaskDetail$StepStatus"/>
        <typeHandler handler="com.example.asynctask.handler.EventTypeTypeHandler" javaType="com.example.asynctask.entity.TaskEventLog$EventType"/>
    </typeHandlers>
</configuration>